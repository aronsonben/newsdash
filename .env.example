# Vite environment variables must be prefixed with VITE_ and are PUBLIC (bundled into the browser).
# Never put secrets in a VITE_ variable.
VITE_API_BASE_URL=
VITE_API_KEY=
VITE_SITE_URL='http://localhost:5173'
VITE_SITE_TITLE='NewsDash (Dev)'

# Firebase browser API key for the client SDK (auth, saved blocks). Public by design;
# restrict it by HTTP referrer and API in Google Cloud Console.
VITE_FIREBASE_BROWSER_API_KEY=

# ── Server-only (Vercel dashboard for production, .env.local for `vercel dev`) ─────

# Gemini
GEMINI_API_KEY=
# Optional: override the server-pinned model (default set in api/_lib/gemini.ts)
GEMINI_MODEL=
# Optional: hours before /api/generate will call Gemini again for the same shortcut (default 6)
GENERATE_COOLDOWN_HOURS=6

# Firebase Admin: base64 of the service account JSON key, on one line:
#   base64 -i service-account.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_B64=

# Bearer secret shared with the GitHub Actions cron jobs (also add as the CRON_SECRET repo secret).
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Signs one-click unsubscribe links in digest emails. Generate with: openssl rand -hex 32
UNSUBSCRIBE_HMAC_SECRET=

# Weekly digest email (Resend)
RESEND_API_KEY=
EMAIL_FROM=
APP_URL='https://newsdash.concourse.codes'
# Used only when NODE_ENV=development
LOCAL_EMAIL_FROM=
DEV_APP_URL='http://localhost:3000'
