# Vite environment variables must be prefixed with VITE_
VITE_API_BASE_URL=
VITE_API_KEY=
VITE_SITE_URL='http://localhost:5173'
VITE_SITE_TITLE='NewsDash (Dev)'

# ── Gemini API ─────────────────────────────────────────────────────────────────
# Server-side only (Vercel dashboard / .env.local for `vercel dev`); never prefix with VITE_
GEMINI_API_KEY=

# Firebase client API key — used by the serverless cache/blocks functions
# Set in .env.local for local dev (vercel dev), and in Vercel dashboard for production
FIREBASE_BROWSER_API_KEY=

# Firebase client API key — used by the browser-side Firebase SDK (auth, client-side Firestore)
# Prefix with VITE_ so Vite exposes it to the browser bundle; safe to commit (key is public)
VITE_FIREBASE_BROWSER_API_KEY=
